%header.with-proposition.c-hmlr-header#global-header
  .header-wrapper
    .header-global
      .header-logo
        = link_to(root_path(lang: I18n.locale), class: 'content', title: t('common.header.home_link')) do
          = vite_image_tag('images/ukhpi-icon.png', srcset: vite_asset_path('images/ukhpi-icon.svg'), alt: 'UKHPI Logo')

    .header-proposition
      .content
        = link_to(t('common.header.menu_text'), '#proposition-links', class: 'menu sr-only')
        %nav#proposition-menu{ 'aria-label' => 'application menu' }
          = link_to(t('common.header.app_title'), root_path(lang: I18n.locale), id: "proposition-name")

          %ul#proposition-links
            %li
              = link_to(t('action.browse'), browse_path(lang: I18n.locale), class: active_class(browse_path))
            %li
              = link_to(t('action.compare_locations'), compare_path(lang: I18n.locale), class: active_class(compare_path))
            %li
              = link_to(t('action.sparql'), '/app/qonsole')
            %li
              = link_to(t('action.user_guide'), doc_ukhpi_user_guide_path(lang: I18n.locale))
            %li
              = link_to(t('action.about'), doc_index_path(lang: I18n.locale), class: active_class(doc_index_path))
            %li
              = link_to(t('action.changelog'), changelog_index_path(lang: I18n.locale), class: active_class(changelog_index_path))



    = render partial: 'common/accredited_statistic_logo'
.o-lr-top-bar

.container.o-container
  .o-secondary-banner
    - if Rails.application.config.welsh_language_enabled
      %nav.o-secondary-banner__lang-select{ 'aria-label' => 'language selector' }
        - user_selections = @view_state.respond_to?(:[]) ? @view_state[:user_selections] : @view_state.user_selections
        - if user_selections.english?
          English
        - else
          = link_to('English', user_selections.alternative_language_params.params)
        |
        - if user_selections.welsh?
          Cymraeg
        - else
          = link_to('Cymraeg', user_selections.alternative_language_params.params)
