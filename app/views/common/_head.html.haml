%head
  %meta{ charset: 'utf-8', httpEquiv:'Content-Type' }
  %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }
  %title
    = (yield(:title) + " - " unless yield(:title).blank?).to_s + I18n.t('common.header.app_title')
  = render partial: 'common/favicons'
  = vite_client_tag
  :javascript
    document.querySelector('html').classList.add('js')
    window.ukhpi ||= {}
    window.ukhpi.environment = "#{ENV.fetch('SENTRY_ENVIRONMENT', Rails.env)}"
    window.ukhpi.version = "#{Version::VERSION}"
    window.ukhpi.locale = "#{I18n.locale}"
    window.ukhpi.root_path = "#{Rails.application.config.relative_url_root}"
  - if Rails.env.production? || Rails.logger.debug?
    = vite_javascript_tag 'cookie', defer: true
    = csrf_meta_tags
  -#
    `media` applies to the stylesheets the entrypoint imports. Rails 7.0 stopped
    defaulting stylesheet links to `media="screen"`, so keep it explicit.
  = vite_javascript_tag 'application', media: 'screen'
  = vite_stylesheet_tag 'application', media: 'all'

  - if @preferences
    %link{ rel: 'canonical', href: '//#{request.host_with_port}#{@preferences.as_path(:view)}' }

  %link{ rel:'license', href: 'http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3' }
