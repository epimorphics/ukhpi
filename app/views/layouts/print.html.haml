%html{ lang: 'en', data: { 'rails-env': Rails.env, GA_ID: Rails.application.config.google_analytics_id} }
  = render partial: 'common/head'

  %body.government.website.hmlr
    %header.with-proposition.c-hmlr-header#global-header
      .header-wrapper
        .header-global
          .header-logo
            %a.content{ href: "#{Rails.application.config.relative_url_root}", title: t('common.header.home_link') }
              = vite_image_tag('images/ukhpi-icon.png', srcset: vite_asset_path('images/ukhpi-icon.svg'), alt: 'UKHPI Logo')
        .header-proposition
          .content
            %nav#proposition-menu
              %a#proposition-name{ href: "#{Rails.application.config.relative_url_root}" }
                %strong
                  = I18n.t('common.header.app_title')

    .o-lr-top-bar

    = render partial: 'common/flash_message'
    %main#main-content.container.o-container
      .row
        .col-md-12
          = yield

    = render partial: 'common/footer'
