%html{ lang: 'en', data: { 'rails-env': Rails.env, GA_ID: Rails.application.config.google_analytics_id} }
  %head
    %meta{ charset: 'utf-8', httpEquiv:'Content-Type' }
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }
    %title
      = (yield(:title) + " - " unless yield(:title).blank?).to_s + I18n.t('common.header.app_title')
    = render partial: 'common/favicons'
    = vite_client_tag
    :javascript
      document.querySelector('html').classList.add('js')
      window.ukhpi ||= {}
      window.ukhpi.environment = "#{ENV.fetch('SENTRY_ENVIRONMENT', Rails.env)}"
      window.ukhpi.version = "#{Version::VERSION}"
      window.ukhpi.locale = "#{I18n.locale}"
      window.ukhpi.root_path = "#{Rails.application.config.relative_url_root}"
    - if Rails.env.production? || Rails.logger.debug?
      = vite_javascript_tag 'cookie', defer: true
      = csrf_meta_tags
    = vite_javascript_tag 'application'
    = vite_stylesheet_tag 'application', media: 'all'

    - if @preferences
      %link{ rel: 'canonical', href: '//#{request.host_with_port}#{@preferences.as_path(:view)}' }

    %link{ rel:'license', href: 'http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3' }

    /[if lt IE 9]
      = javascript_include_tag '//cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js'
      = javascript_include_tag '//cdn.jsdelivr.net/es5.shim/4.5.7/es5-shim.js'
      = javascript_include_tag '//cdn.jsdelivr.net/es5.shim/4.5.7/es5-sham.js'
      = javascript_include_tag '//cdn.jsdelivr.net/lodash/4.9.0/lodash.js'
      :javascript
        window.isIE8 = true;

    = javascript_pack_tag 'ukhpi_vue', defer: true

  %body.government.website.hmlr
    = render partial: 'common/cookie_banner' if Rails.env.production? || Rails.logger.debug?
    = render partial: 'common/skip_to_main_content'
    = render partial: 'common/header'
    = render partial: 'common/flash_message'

    %main#main-content.container.o-container
      .row
        .col-md-12
          = yield

      .row
        .o-feedback
          %p.text-muted
            = t('common.header.feedback_request').html_safe

    = render partial: 'common/footer'
    = render partial: 'common/puma_stats' if Rails.env.development?
