<!doctype html>
<html lang="<%= I18n.locale %>" xml:lang="<%= I18n.locale %>" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title><%= (yield(:title) + " - " unless yield(:title).blank?).to_s + I18n.t('common.header.app_title') %></title>
    <%= render partial: 'common/favicons' %>
    <script>
      document.querySelector('html').classList.add('js');
      window.ukhpi ||= {};
      window.ukhpi.environment
      window.ukhpi.version
      window.ukhpi.locale
    </script>
    <% if Rails.env.production? %>
      <%= render partial: 'common/google-analytics' %>
      <%= javascript_include_tag 'cookie', defer: true %>
    <% end %>
    <%= vite_client_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_stylesheet_tag 'application', media: 'all' %>
    <%= vite_javascript_tag 'application' %>
    <% if @preferences %>
      <link href="//<%= request.host_with_port %><%= @preferences.as_path(:view) %>" rel="canonical" />
    <% end %>
    <link href="http://www.nationalarchives.gov.uk/doc/open-government-licence/version/3" rel="license" />

    <!--[if lt IE 9]>
      <%= javascript_include_tag '//cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js' %>
      <%= javascript_include_tag '//cdn.jsdelivr.net/es5.shim/4.5.7/es5-shim.js' %>
      <%= javascript_include_tag '//cdn.jsdelivr.net/es5.shim/4.5.7/es5-sham.js' %>
      <%= javascript_include_tag '//cdn.jsdelivr.net/lodash/4.9.0/lodash.js' %>
      <script>
        window.isIE8 = true;
      </script>
    <![endif]-->

  </head>
  <body class="government website lr">
    <%= render partial: 'common/cookie_banner' if Rails.env.production? %>
    <%= render partial: 'common/skip_to_main_content' %>
    <%= render partial: 'common/header' %>
    <%= render partial: 'common/flash_message' %>
    <main id="main-content" class="container o-container">
      <%= yield %>
    </main>
    <%= render partial: 'common/footer' %>
    <%= render partial: 'common/puma_stats' if Rails.env.development? %>
  </body>
</html>
